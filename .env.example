# --- Required ---
# The database is Cloudflare D1 (binding DB in wrangler.jsonc); no connection string is needed.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stripe (optional; without a secret key checkout uses a simulated test-payment page) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Manual payment handles shown at checkout ---
PAYMENT_ZELLE_HANDLE="payments@lazerlayer.com"
PAYMENT_CASHAPP_HANDLE="$LazerLayer"
PAYMENT_VENMO_HANDLE="@LazerLayer"

# --- Email via Resend (optional; without a key emails are logged to the server console) ---
RESEND_API_KEY=""
EMAIL_FROM="LazerLayer <orders@lazerlayer.com>"
ADMIN_NOTIFY_EMAIL="admin@lazerlayer.com"

# --- Seed overrides (optional) ---
SEED_ADMIN_EMAIL="admin@lazerlayer.com"
SEED_ADMIN_PASSWORD="LazerAdmin123!"
# Set to false in production to skip the demo customer, order and ticket
SEED_DEMO_CUSTOMER=true
